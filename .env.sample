# GeoRiva settings.
#
# Server: cp .env.sample deploy/.env, fill in section 1, then run ./deploy.sh <version>
# Dev:    cp .env.sample .env, fill in sections 1 and 2.
#
# Lines without a # are the ones you must set. Everything else is commented out
# at its default: remove the # only to change it.

# ── 1. Must set ───────────────────────────────────────────────────────────────

# A long random string. Generate one: openssl rand -base64 48
SECRET_KEY=

# Database login, created on first start.
GEORIVA_DB_USER=
GEORIVA_DB_PASSWORD=
GEORIVA_DB_NAME=

# File storage login. The password needs at least 8 characters.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Your server's domain, e.g. georiva.example.org. Organisations live at
# <name>.georiva.example.org. Choose it before first start (see deploy/README.md).
# Dev: leave blank for localhost.
GEORIVA_BASE_DOMAIN=

# Where data senders upload: s3.<your domain>, e.g. s3.georiva.example.org.
# Dev: leave blank.
MINIO_PUBLIC_ENDPOINT=

# ── 2. Set by tooling or for dev only ─────────────────────────────────────────

# The version this server runs. Written by deploy.sh; don't edit. Not used in dev.
GEORIVA_TAG=

# Dev only: the Docker network to join.
GEORIVA_NETWORK_NAME=

# ── 3. Behind HTTPS: uncomment both ───────────────────────────────────────────

# GEORIVA_SITE_PORT=443
# MINIO_PUBLIC_ENDPOINT_USE_SSL=true

# ══ Optional — everything below is commented out at its default ═══════════════

# ── Extra hostnames ───────────────────────────────────────────────────────────
# Only if you serve other hostnames besides your domain. Comma-separated.
# ALLOWED_HOSTS=
# CSRF_TRUSTED_ORIGINS=

# ── Organisations ─────────────────────────────────────────────────────────────
# The first organisation, created on your main domain. Its slug can't be renamed later.
# GEORIVA_BOOTSTRAP_CENTRAL_ORG=true
# GEORIVA_CENTRAL_ORG_SLUG=central

# ── Email ─────────────────────────────────────────────────────────────────────
# SMTP_EMAIL_HOST=
# SMTP_EMAIL_PORT=
# SMTP_EMAIL_USE_TLS=
# SMTP_EMAIL_HOST_USER=
# SMTP_EMAIL_HOST_PASSWORD=
# DJANGO_ADMINS=
# WAGTAILADMIN_BASE_URL=

# ── Site basics ───────────────────────────────────────────────────────────────
# DEBUG=False
# WAGTAIL_SITE_NAME=GeoRiva
# TIME_ZONE=UTC
# LANGUAGE_CODE=en

# ── Workers ───────────────────────────────────────────────────────────────────
# GEORIVA_GUNICORN_NUM_OF_WORKERS=4
# GEORIVA_GUNICORN_TIMEOUT=300

# General background tasks. 2 in dev.
# GEORIVA_CELERY_DEFAULT_WORKER_CONCURRENCY=4

# Data ingestion. Keep at 1; add containers to scale.
# GEORIVA_CELERY_INGESTION_WORKER_CONCURRENCY=1

# Heavy processing. Keep below your CPU count. 2 in dev.
# GEORIVA_CELERY_PROCESSING_WORKER_CONCURRENCY=4

# ── Fetch tuning ──────────────────────────────────────────────────────────────
# Hours before a stuck download is restarted. Keep above your longest download.
# GEORIVA_FETCH_RUN_STALE_AFTER_HOURS=6

# Stop a download after this many failures in a row.
# GEORIVA_FETCH_CIRCUIT_BREAKER_THRESHOLD=3

# Longest a download may run, in seconds.
# GEORIVA_FETCH_RUN_MAX_SECONDS=7200

# How many times a failed download is retried.
# GEORIVA_FETCH_RUN_MAX_RETRIES=4

# Seconds to cache the WMTS capabilities list. 0 turns caching off.
# GEORIVA_WMTS_CAPABILITIES_CACHE_SECONDS=300

# ── Logging ───────────────────────────────────────────────────────────────────
# GEORIVA_LOG_LEVEL=WARN
# GEORIVA_DATABASE_LOG_LEVEL=ERROR
# GEORIVA_CELERY_BEAT_DEBUG_LEVEL=INFO
# GEORIVA_CELERY_WORKER_LOG_LEVEL=INFO

# strict or warn. Leave on strict (see deploy/README.md).
# GEORIVA_TASK_CONTEXT_MODE=strict

# ── Startup ───────────────────────────────────────────────────────────────────
# MIGRATE_ON_STARTUP=true
# COLLECT_STATICFILES_ON_STARTUP=true

# ── Plugins ───────────────────────────────────────────────────────────────────
# GEORIVA_PLUGIN_DIR=/georiva/plugins
# GEORIVA_PLUGIN_URLS=
# GEORIVA_PLUGIN_SETUP_ALREADY_RUN=
# GEORIVA_DISABLE_PLUGIN_INSTALL_ON_STARTUP=true
# true = a plugin missing a required setting is an error, not a warning.
# GEORIVA_STRICT_PLUGIN_ENV=false

# ── External storage ──────────────────────────────────────────────────────────
# Defaults use the bundled storage. Set these only to use another S3 service.
# GEORIVA_STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=georiva
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=http://georiva-minio:9000
# AWS_S3_CUSTOM_DOMAIN=
# AWS_DEFAULT_ACL=
# AWS_QUERYSTRING_AUTH=True
# AWS_S3_FILE_OVERWRITE=True
# AWS_S3_SIGNATURE_VERSION=s3v4
# AWS_S3_ADDRESSING_STYLE=path

# ── Paths and ports ───────────────────────────────────────────────────────────
# MINIO_VOLUME=./docker/minio
# GEORIVA_DB_VOLUME=./docker/db_data/
# GEORIVA_STATIC_VOLUME=./docker/static
# GEORIVA_MEDIA_VOLUME=./docker/media
# GEORIVA_BACKUP_VOLUME=./docker/backup
# GEORIVA_TILE_CACHE_VOLUME=./docker/tile_cache
# Port the website listens on.
# GEORIVA_WEB_PROXY_PORT=80
