# GeoRiva environment — the one complete list, for servers and dev alike.
#
# Server: cp .env.sample deploy/.env, fill in section 1, then ./deploy.sh <version>
#         (deploy/README.md).
# Dev:    cp .env.sample .env, fill in section 1 and 2. docker-compose.dev.yml
#         supplies the dev values (DEBUG, localhost domain, smaller pools)
#         for whatever is left blank here.
#
# Active lines (no leading #) are the ones you must set. Everything else is
# commented out with its default: uncomment a line only to change it. A new
# setting that a server must set goes in section 1; anything with a safe
# default goes in the optional part, commented.

# ── 1. Must set ───────────────────────────────────────────────────────────────

# A long random string: openssl rand -base64 48
SECRET_KEY=

# Database credentials, created on first start.
GEORIVA_DB_USER=
GEORIVA_DB_PASSWORD=
GEORIVA_DB_NAME=

# Object-store credentials. The password needs at least 8 characters.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Tenancy: organisations are served at <org-slug>.<GEORIVA_BASE_DOMAIN>, and the
# central organisation at the base domain itself. Needs wildcard DNS (and TLS) for
# *.<base domain>. Session/CSRF cookies are scoped to ".<base domain>" so one login
# covers every organisation — unless the base domain has no dot (e.g. "localhost").
# Hostnames are written once, when an organisation is provisioned: changing this on
# an initialized instance leaves every organisation on the old domain and the new
# one matching nothing, so run `georiva sync_site_domains --from <old domain>`.
# The base domain and all its subdomains are already allowed hosts and trusted
# https:// CSRF origins. Required on a server; blank = localhost in dev.
GEORIVA_BASE_DOMAIN=

# Address senders and public asset URLs reach MinIO at. For push feeds this must be the proxy's `s3.<domain>` name
# (e.g. s3.example.org, or s3.localhost:<GEORIVA_WEB_PROXY_PORT> in dev; include the port when it isn't 80/443).
# Required on a server. Blank = localhost:9000 in dev, which hits MinIO directly and bypasses the proxy.
MINIO_PUBLIC_ENDPOINT=

# ── 2. Set by tooling or for dev only ─────────────────────────────────────────

# The release this server runs, e.g. v0.5.0 (also `main` or `sha-<short>`).
# Written by deploy/deploy.sh — set it by running that, not by hand. Unused in dev.
GEORIVA_TAG=

# External Docker network the dev stack (root docker-compose.yml) joins. Unused on
# servers: deploy/ uses compose's own network (see its override sample).
GEORIVA_NETWORK_NAME=

# ── 3. Behind TLS: uncomment both ─────────────────────────────────────────────

# Port the organisation Sites are created on — the web proxy's. Default 80.
# Wagtail reads the *scheme* off the port (80 -> http://, 443 -> https://) and every
# absolute URL the APIs advertise is built from it, so leaving it at 80 on an HTTPS
# instance makes STAC and EDR hand out http:// self links — which STAC Browser reads
# as a different origin and refuses to follow. Changing it after organisations exist
# needs `georiva sync_site_ports`.
# GEORIVA_SITE_PORT=443
# Set once TLS is in place.
# MINIO_PUBLIC_ENDPOINT_USE_SSL=true

# ══ Optional — everything below is commented out at its default ═══════════════

# ── Extra hostnames ───────────────────────────────────────────────────────────
# Only for hostnames beyond the base domain and its subdomains. Comma-separated.
# ALLOWED_HOSTS=
# CSRF_TRUSTED_ORIGINS=

# ── Organisations ─────────────────────────────────────────────────────────────
# First setup binds Wagtail's default Site to an ordinary "central" organisation on
# the base domain, so a single-institution install needs no tenancy ceremony. The
# slug is that organisation's immutable DNS label and storage-key prefix; changing
# it after bootstrap does not rename anything already provisioned.
# GEORIVA_BOOTSTRAP_CENTRAL_ORG=true
# GEORIVA_CENTRAL_ORG_SLUG=central

# ── Email ─────────────────────────────────────────────────────────────────────
# SMTP_EMAIL_HOST=
# SMTP_EMAIL_PORT=
# SMTP_EMAIL_USE_TLS=
# SMTP_EMAIL_HOST_USER=
# SMTP_EMAIL_HOST_PASSWORD=
# DJANGO_ADMINS=
# WAGTAILADMIN_BASE_URL=

# ── Site basics ───────────────────────────────────────────────────────────────
# DEBUG=False
# WAGTAIL_SITE_NAME=GeoRiva
# TIME_ZONE=UTC
# LANGUAGE_CODE=en

# ── Workers ───────────────────────────────────────────────────────────────────
# GEORIVA_GUNICORN_NUM_OF_WORKERS=4
# GEORIVA_GUNICORN_TIMEOUT=300

# Default worker (Wagtail, cache, email, etc.). Default 4 (2 in dev).
# GEORIVA_CELERY_DEFAULT_WORKER_CONCURRENCY=4

# Ingestion worker — keep at 1, scale by adding containers instead
# GEORIVA_CELERY_INGESTION_WORKER_CONCURRENCY=1

# Processing worker — derivation units do a heavy 2-pass COG encode. Default 4
# (2 in dev): keeps backfills moving without oversubscribing. Do not set it
# near/above the CPU count (oversubscription thrashes and can wedge units).
# Bounded per-unit by run_unit_task's soft/hard time limits.
# GEORIVA_CELERY_PROCESSING_WORKER_CONCURRENCY=4

# ── Fetch tuning ──────────────────────────────────────────────────────────────
# A fetch run stuck in "running" longer than this is declared dead by the
# crash-recovery sweep and auto-resumed. Must exceed the longest legitimate
# fetch run. Also sizes the Celery broker visibility_timeout (this + 1h).
# GEORIVA_FETCH_RUN_STALE_AFTER_HOURS=6

# A fetch run stops after this many consecutive transient failures (timeouts,
# dropped connections, 5xx); a success or a file-scoped failure resets the count.
# GEORIVA_FETCH_CIRCUIT_BREAKER_THRESHOLD=3

# Wall-clock limit for one fetch run, checked before each file starts (a file in
# progress is bounded by its own `max_file_seconds`, default 900). Past it the
# run ends FAILED and the files it never reached are retryable.
# GEORIVA_FETCH_RUN_MAX_SECONDS=7200

# How many times a run that ended with failures is retried, from its own plan, at
# 5, 15, 45 and 120 minutes. The run that fails after the last retry is parked.
# Crash recovery of an interrupted run counts against the same cap.
# GEORIVA_FETCH_RUN_MAX_RETRIES=4

# How long the anonymous WMTS capabilities document is cached per organisation.
# Legacy GIS clients re-fetch it on every connection. A newly ingested run
# appears in it once the entry expires, so keep this to minutes. 0 disables.
# GEORIVA_WMTS_CAPABILITIES_CACHE_SECONDS=300

# ── Logging ───────────────────────────────────────────────────────────────────
# GEORIVA_LOG_LEVEL=WARN
# GEORIVA_DATABASE_LOG_LEVEL=ERROR
# GEORIVA_CELERY_BEAT_DEBUG_LEVEL=INFO
# GEORIVA_CELERY_WORKER_LOG_LEVEL=INFO

# Chained tasks with no propagated context: strict (default, raises) or warn (logs and continues).
# Drain the Celery queues before upgrading to strict; tasks queued by older releases carry no headers.
# GEORIVA_TASK_CONTEXT_MODE=strict

# ── Startup ───────────────────────────────────────────────────────────────────
# MIGRATE_ON_STARTUP=true
# COLLECT_STATICFILES_ON_STARTUP=true

# ── Plugins ───────────────────────────────────────────────────────────────────
# GEORIVA_PLUGIN_DIR=/georiva/plugins
# GEORIVA_PLUGIN_URLS=
# GEORIVA_PLUGIN_SETUP_ALREADY_RUN=
# GEORIVA_DISABLE_PLUGIN_INSTALL_ON_STARTUP=true
# Plugins declare required env vars in georiva_plugin_info.json ("requires_env"); a missing one
# is reported by `manage.py check` / migrate. Set true to make it an error instead of a warning.
# GEORIVA_STRICT_PLUGIN_ENV=false

# ── External storage ──────────────────────────────────────────────────────────
# Defaults point at the bundled MinIO. Set these only to use another S3 service.
# GEORIVA_STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=georiva
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=http://georiva-minio:9000
# AWS_S3_CUSTOM_DOMAIN=
# AWS_DEFAULT_ACL=
# AWS_QUERYSTRING_AUTH=True
# AWS_S3_FILE_OVERWRITE=True
# AWS_S3_SIGNATURE_VERSION=s3v4
# AWS_S3_ADDRESSING_STYLE=path

# ── Paths and ports ───────────────────────────────────────────────────────────
# MINIO_VOLUME=./docker/minio
# GEORIVA_DB_VOLUME=./docker/db_data/
# GEORIVA_STATIC_VOLUME=./docker/static
# GEORIVA_MEDIA_VOLUME=./docker/media
# GEORIVA_BACKUP_VOLUME=./docker/backup
# GEORIVA_TILE_CACHE_VOLUME=./docker/tile_cache
# Host port the web proxy listens on.
# GEORIVA_WEB_PROXY_PORT=80
