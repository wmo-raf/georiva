GEORIVA_DB_USER=
GEORIVA_DB_PASSWORD=
GEORIVA_DB_NAME=

GEORIVA_GUNICORN_NUM_OF_WORKERS=4

# Default worker (Wagtail, cache, email, etc.)
GEORIVA_CELERY_DEFAULT_WORKER_CONCURRENCY=4

# Ingestion worker — keep at 1, scale by adding containers instead
GEORIVA_CELERY_INGESTION_WORKER_CONCURRENCY=1

# Processing worker — derivation units do a heavy 2-pass COG encode. Default 4:
# keeps backfills moving without oversubscribing. Lower it on small dev machines;
# do not set it near/above the CPU count (oversubscription thrashes and can wedge
# units). Bounded per-unit by run_unit_task's soft/hard time limits.
GEORIVA_CELERY_PROCESSING_WORKER_CONCURRENCY=4

# A fetch run stuck in "running" longer than this is declared dead by the
# crash-recovery sweep and auto-resumed. Must exceed the longest legitimate
# fetch run. Also sizes the Celery broker visibility_timeout (this + 1h).
GEORIVA_FETCH_RUN_STALE_AFTER_HOURS=6

GEORIVA_GUNICORN_TIMEOUT=300
DEBUG=False
WAGTAIL_SITE_NAME=GeoRiva
ADMIN_URL_PATH=georiva-admin
TIME_ZONE=UTC
SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DJANGO_ADMINS=
WAGTAILADMIN_BASE_URL=
LANGUAGE_CODE=en

# Tenancy: organisations are served at <org-slug>.<GEORIVA_BASE_DOMAIN>, and the
# central organisation at the base domain itself. Needs wildcard DNS (and TLS) for
# *.<base domain>. Session/CSRF cookies are scoped to ".<base domain>" so one login
# covers every organisation — unless the base domain has no dot (e.g. "localhost").
# Hostnames are written once, when an organisation is provisioned: changing this on
# an initialized instance leaves every organisation on the old domain and the new
# one matching nothing, so run `georiva sync_site_domains --from <old domain>`.
GEORIVA_BASE_DOMAIN=localhost
# Port the organisation Sites are created on (80 behind the proxy, 8000 in dev).
# Set this to 443 behind TLS. Wagtail reads the *scheme* off the port (80 ->
# http://, 443 -> https://) and every absolute URL the APIs advertise is built
# from it, so leaving it at 80 on an HTTPS instance makes STAC and EDR hand out
# http:// self links — which STAC Browser reads as a different origin and refuses
# to follow. Changing it after organisations exist needs `georiva sync_site_ports`.
GEORIVA_SITE_PORT=80
# First setup binds Wagtail's default Site to an ordinary "central" organisation on
# the base domain, so a single-institution install needs no tenancy ceremony. The
# slug is that organisation's immutable DNS label and storage-key prefix; changing
# it after bootstrap does not rename anything already provisioned.
GEORIVA_BOOTSTRAP_CENTRAL_ORG=true
GEORIVA_CENTRAL_ORG_SLUG=central
GEORIVA_LOG_LEVEL=WARN
GEORIVA_DATABASE_LOG_LEVEL=ERROR
GEORIVA_CELERY_BEAT_DEBUG_LEVEL=INFO
GEORIVA_CELERY_WORKER_LOG_LEVEL=INFO
MIGRATE_ON_STARTUP=true
COLLECT_STATICFILES_ON_STARTUP=true
GEORIVA_PLUGIN_DIR=
GEORIVA_PLUGIN_URLS=
GEORIVA_PLUGIN_SETUP_ALREADY_RUN=
GEORIVA_DISABLE_PLUGIN_INSTALL_ON_STARTUP=true

GEORIVA_STORAGE_BACKEND=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_DEFAULT_ACL=
AWS_QUERYSTRING_AUTH=
AWS_S3_FILE_OVERWRITE=
AWS_S3_SIGNATURE_VERSION=
AWS_S3_ADDRESSING_STYLE=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_VOLUME=./docker/minio
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT_USE_SSL=false

GEORIVA_STATIC_VOLUME=./docker/static
GEORIVA_MEDIA_VOLUME=./docker/media
GEORIVA_BACKUP_VOLUME=./docker/backup
GEORIVA_TILE_CACHE_VOLUME=./docker/tile_cache

GEORIVA_WEB_PROXY_PORT=
GEORIVA_NETWORK_NAME=
